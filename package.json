{
  "name": "decore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @decore/storefront --filter @decore/admin dev",
    "dev:site": "pnpm --filter @decore/storefront dev",
    "dev:admin": "pnpm --filter @decore/admin dev",
    "build": "pnpm --filter @decore/storefront --filter @decore/admin build",
    "start:site": "pnpm --filter @decore/storefront start",
    "start:admin": "pnpm --filter @decore/admin start",
    "lint": "eslint apps packages --max-warnings=0",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @decore/db generate",
    "db:seed": "pnpm --filter @decore/db db:seed",
    "db:migrate": "pnpm --filter @decore/db db:migrate",
    "db:studio": "pnpm --filter @decore/db db:studio"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.3"
}
