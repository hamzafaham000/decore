generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CheckoutMethod {
  CARD
  WHATSAPP
  COD
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  CONFIRMED
  PAID
  DISPATCHED
  CANCELLED
}

model Order {
  id        String      @id @default(cuid())
  reference String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  status    OrderStatus @default(AWAITING_CONFIRMATION)

  method CheckoutMethod

  customerName   String
  phone          String
  email          String?
  addressLine1   String
  addressLine2   String?
  city           String
  notes          String?
  cancellationOk Boolean   @default(false)

  // Whole Pakistani Rupees. No subunit is used anywhere in the catalogue.
  subtotal    Int
  deliveryFee Int
  total       Int
  advanceDue  Int
  balanceDue  Int
  advancePaid Boolean @default(false)

  items OrderItem[]

  @@index([createdAt])
  @@index([phone])
}

model OrderItem {
  id          String @id @default(cuid())
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  productSlug String
  name        String
  unitPrice   Int
  quantity    Int
  finish      String?

  @@index([orderId])
}

enum ProductGlyph {
  SEATING
  TABLE
  LIGHTING
  WORKSPACE
  OBJECT
}

enum Surface {
  HOME
  OFFICE
}

enum DetailKind {
  MATERIAL
  DIMENSION
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  label    String
  blurb    String
  position Int       @default(0)
  products Product[]

  @@index([position])
}

model Product {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId    String
  surfaces      Surface[]
  price         Int
  tagline       String
  description   String
  finishes      String[]
  materials     Json
  dimensions    Json
  leadTimeWeeks Int          @default(4)
  glyph         ProductGlyph
  published     Boolean      @default(true)
  featured      Boolean      @default(false)
  position      Int          @default(0)
  images        ProductImage[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([categoryId])
  @@index([published, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId, position])
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  device    String?
  country   String?
  visitor   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
