# Copy to .env and fill in real values.
DATABASE_URL="postgresql://decore:decore@localhost:5432/decore?schema=public"
WHATSAPP_NUMBER="923169650686"
# Public origin for canonicals, openGraph, sitemap.xml and robots.txt.
# Falls back to http://localhost:3000 when unset, which is right in dev only.
SITE_URL="https://decore.pk"
# Gateway credentials go here with the real call in src/lib/payments.ts.

# Dashboard login. Set both, then run pnpm db:seed (or leave unset in prod and
# create the owner with a one-off seed).
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me"
